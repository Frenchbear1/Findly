{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Findly",
  "version": "1.0.0",
  "identifier": "com.davidlabarre.instantsearch",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Findly",
        "width": 1280,
        "height": 840,
        "minWidth": 420,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5f4f1"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Search every page of your documents",
    "publisher": "David LaBarre"
  }
}
